{
  "name": "obsidian-print-studio",
  "version": "0.3.9",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "test": "tsx --test tests/*.test.ts",
    "package": "npm run check && node scripts/notices.mjs && node scripts/package.mjs",
    "test:browser": "npm run build && node scripts/build-tests.mjs && playwright test",
    "lint": "eslint src --max-warnings 0",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "dompurify": "^3.2.7",
    "pagedjs": "0.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "jsdom": "^26.1.0",
    "marked": "^15.0.0",
    "obsidian": "1.13.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6"
  },
  "engines": {
    "node": ">=22"
  }
}
